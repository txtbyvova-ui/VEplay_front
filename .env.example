VITE_API_BASE=http://localhost:3001
# For production (Caddy proxies API paths on the same domain):
# VITE_API_BASE=https://play.vegroove.tech

# ── server.mjs runtime (set in your shell / pm2 / systemd, NOT read from this file) ──
# server.mjs reads process.env directly; these are documented here for reference.
#
# MUSIC_ROOT      — root of client folders (default: ../VEplay_demo)
# DATA_DIR        — where users.json / .secret / pending_batches.json live (default: alongside server.mjs)
#
# VEclassify bridge (audio → morning/day/evening classification):
# CLASSIFY_PYTHON — python interpreter that runs VEclassify
#                   (default: ../VEclassify/.venv/{Scripts/python.exe|bin/python}, else python3)
# CLASSIFY_SCRIPT — path to classify_stage.py (default: ../VEclassify/classify_stage.py)
# MAX_UPLOAD_BYTES— max total bytes per classify batch upload (default: 2147483648 = 2 GB)
#                   (over the limit — or over 500 files — the upload is answered with 413)
# CLASSIFY_TIMEOUT_MS — hard cap on one classifier run; a python child that never exits is
#                   killed and the batch goes to 'error' instead of hanging in 'classifying'
#                   (default: 3600000 = 1h)
# DRAIN_TIMEOUT_MS— how long a rejected (413) upload body keeps being drained so the client
#                   actually receives the status instead of ECONNRESET (default: 15000)
#
# HTTP timeouts (large audio uploads need more than Node's 300s default, which
# otherwise emits 408 mid-upload):
# REQUEST_TIMEOUT_MS — max time to receive a full request (default: 3600000 = 1h; 0 disables)
# HEADERS_TIMEOUT_MS — max time to receive headers (default: 60000 = 60s; clamped to <= REQUEST_TIMEOUT_MS)
